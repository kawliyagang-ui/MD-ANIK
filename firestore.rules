rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /custom_media/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /announcements/{document} {
      allow read: if true;
      allow write: if true;
    }
    match /ad_config/{document} {
      allow read: if true;
      allow write: if true;
    }
  }
}
